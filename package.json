  },
  "dependencies": {
    "@tinlynk/protocol": "file:../protocol"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "engines": { "node": ">=22.0.0" }

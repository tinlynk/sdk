{
  "name": "@tinlynk/sdk",
  "version": "0.1.0",
  "private": false,
  "description": "TinLynk SDK: model and tool clients, transports, agent runtime.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
